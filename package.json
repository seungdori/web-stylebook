{
  "name": "web-stylebook",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint . --ignore-pattern products --ignore-pattern .vite --ignore-pattern packages",
    "i18n:check": "tsx scripts/check-localization.mjs",
    "build": "npm run typecheck && vite build && tsx scripts/generate-static-pages.mjs && tsx scripts/generate-seo.mjs && tsx scripts/generate-agent-handoff.mjs",
    "generate:seo": "tsx scripts/generate-seo.mjs",
    "generate:agent-handoff": "tsx scripts/generate-agent-handoff.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "test": "vitest run",
    "test:watch": "vitest",
    "mcp:catalog": "tsx scripts/generate-mcp-catalog.mts",
    "mcp:catalog:check": "tsx scripts/check-mcp-catalog.mts",
    "mcp:catalog:validate": "tsx scripts/validate-mcp-catalog.mts",
    "references:import": "tsx scripts/import-design-references.mts"
  },
  "dependencies": {
    "motion": "^12.38.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.1",
    "vite": "^8.0.10",
    "vitest": "^4.1.9",
    "zod": "^4.4.3"
  }
}
