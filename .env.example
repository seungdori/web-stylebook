# Copy to `.env` (or set in your host's env). Both are optional.

# Pro Kit checkout — your Lemon Squeezy hosted checkout / overlay URL.
# When empty, the Pro Kit page shows a disabled "checkout coming soon" button
# (payment is intentionally not wired yet).
VITE_PRO_KIT_CHECKOUT_URL=

# Support inbox shown on the support + legal pages and in their mailto: links.
# Defaults to support@webstylebook.com when unset.
VITE_SUPPORT_EMAIL=support@webstylebook.com
