{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "allowImportingTsExtensions": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "noEmit": true,
    "types": ["node", "vite/client"],
    "skipLibCheck": true
  },
  "include": ["vite.config.ts", "scripts/**/*.mjs", "scripts/**/*.ts", "scripts/**/*.mts"]
}
